{
  "id": "sample.basic-vim",
  "name": "Basic Vim",
  "description": "A small modal editor keymap with a block cursor.",
  "version": "0.0.0",
  "browser": "dist/main.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": ["onCommand:basicVim.start", "onCommand:basicVim.stop", "onCommand:basicVim.handleKey"],
  "commands": [
    {
      "id": "basicVim.start",
      "label": "Basic Vim: Start"
    },
    {
      "id": "basicVim.stop",
      "label": "Basic Vim: Stop"
    },
    {
      "id": "basicVim.handleKey",
      "label": "Basic Vim: Handle Key"
    }
  ],
  "keyMap": {
    "cursorStyle": "block",
    "initialMode": "normal",
    "modes": {
      "insert": {
        "bindings": {
          "Escape": {
            "command": "basicVim.handleKey",
            "args": ["Escape"],
            "mode": "normal"
          }
        }
      },
      "normal": {
        "bindings": {
          "$": {
            "command": "basicVim.handleKey",
            "args": ["$"]
          },
          "0": {
            "command": "basicVim.handleKey",
            "args": ["0"]
          },
          "a": {
            "command": "basicVim.handleKey",
            "args": ["a"],
            "mode": "insert"
          },
          "A": {
            "command": "basicVim.handleKey",
            "args": ["A"],
            "mode": "insert"
          },
          "b": {
            "command": "basicVim.handleKey",
            "args": ["b"]
          },
          "h": {
            "command": "basicVim.handleKey",
            "args": ["h"]
          },
          "i": {
            "command": "basicVim.handleKey",
            "args": ["i"],
            "mode": "insert"
          },
          "I": {
            "command": "basicVim.handleKey",
            "args": ["I"],
            "mode": "insert"
          },
          "j": {
            "command": "basicVim.handleKey",
            "args": ["j"]
          },
          "k": {
            "command": "basicVim.handleKey",
            "args": ["k"]
          },
          "l": {
            "command": "basicVim.handleKey",
            "args": ["l"]
          },
          "u": {
            "command": "basicVim.handleKey",
            "args": ["u"]
          },
          "w": {
            "command": "basicVim.handleKey",
            "args": ["w"]
          },
          "x": {
            "command": "basicVim.handleKey",
            "args": ["x"]
          }
        },
        "captureText": true
      }
    }
  }
}
