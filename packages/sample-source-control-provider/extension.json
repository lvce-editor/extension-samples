{
  "id": "sample.source-control-provider",
  "name": "Source Control Provider Sample",
  "description": "A mock source control provider with a changes group and SVG decorations",
  "version": "0.0.0",
  "browser": "dist/main.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": ["onSourceControl:file"],
  "source-control-icons": ["icons/modified.svg"],
  "sourceControlProviders": [
    {
      "id": "source-control-provider"
    }
  ]
}
