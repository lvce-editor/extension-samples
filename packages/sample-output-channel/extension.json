{
  "id": "sample.output-channel",
  "name": "Output Channel Sample",
  "description": "Write, append, and clear simulated build logs in the Output panel.",
  "version": "0.0.0",
  "browser": "dist/main.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": [
    "*",
    "onCommand:sample.runBuild",
    "onCommand:sample.clearBuildOutput",
    "onCommand:sample.cacheBuildArtifact",
    "onCommand:sample.watchFileChanges",
    "onCommand:sample.writeWatchedFile",
    "onCommand:sample.stopWatchingFileChanges",
    "onCommand:sample.reportBuildError"
  ],
  "outputChannels": [
    {
      "id": "sample-build",
      "label": "Sample Build"
    }
  ],
  "commands": [
    {
      "id": "sample.runBuild",
      "label": "Sample: Run Build"
    },
    {
      "id": "sample.clearBuildOutput",
      "label": "Sample: Clear Build Output"
    },
    {
      "id": "sample.cacheBuildArtifact",
      "label": "Sample: Cache Build Artifact"
    },
    {
      "id": "sample.watchFileChanges",
      "label": "Sample: Watch File Changes"
    },
    {
      "id": "sample.writeWatchedFile",
      "label": "Sample: Write Watched File"
    },
    {
      "id": "sample.stopWatchingFileChanges",
      "label": "Sample: Stop Watching File Changes"
    },
    {
      "id": "sample.reportBuildError",
      "label": "Sample: Report Build Error"
    }
  ]
}
