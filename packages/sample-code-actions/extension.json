{
  "id": "sample.code-actions",
  "name": "Code Actions Sample",
  "description": "Organize a block of imports with a source code action.",
  "version": "0.0.0",
  "browser": "dist/main.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": ["onLanguage:sample-code-actions", "onCodeActions:sample-code-actions"],
  "languages": [
    {
      "id": "sample-code-actions",
      "extensions": [".sample"]
    }
  ],
  "codeActions": [
    {
      "kind": "source.organizeImports",
      "name": "Organize Imports",
      "command": "Editor.organizeImports",
      "languageId": "sample-code-actions"
    }
  ]
}
