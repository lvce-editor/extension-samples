{
  "id": "sample.brace-completion",
  "name": "Brace Completion Sample",
  "description": "Insert matching braces for parentheses, brackets, and curly braces.",
  "version": "0.0.0",
  "browser": "dist/main.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": ["onBraceCompletion:plaintext", "onCommand:sample.completeBrace"],
  "commands": [
    {
      "id": "sample.completeBrace",
      "label": "Sample: Complete Brace"
    }
  ]
}
