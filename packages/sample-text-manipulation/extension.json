{
  "id": "sample.text-manipulation",
  "name": "Text Manipulation Sample",
  "description": "Insert text into the active editor.",
  "version": "0.0.0",
  "browser": "dist/main.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": [
    "onCommand:sample.insertText",
    "onCommand:sample.collapseSelections",
    "onCommand:sample.openExampleTabs",
    "onCommand:sample.focusPreviousExampleTab",
    "onCommand:sample.focusNextExampleTab",
    "onCommand:sample.closeExampleTabs"
  ],
  "commands": [
    {
      "id": "sample.insertText",
      "label": "Sample: Insert Text"
    },
    {
      "id": "sample.collapseSelections",
      "label": "Sample: Collapse Selections"
    },
    {
      "id": "sample.openExampleTabs",
      "label": "Sample: Open Example Tabs"
    },
    {
      "id": "sample.focusPreviousExampleTab",
      "label": "Sample: Focus Previous Tab"
    },
    {
      "id": "sample.focusNextExampleTab",
      "label": "Sample: Focus Next Tab"
    },
    {
      "id": "sample.closeExampleTabs",
      "label": "Sample: Close Example Tabs"
    }
  ]
}
