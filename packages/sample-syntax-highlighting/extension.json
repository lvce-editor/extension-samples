{
  "id": "sample.syntax-highlighting",
  "name": "Syntax Highlighting Sample",
  "description": "Contribute a tokenizer for the invented Sprout language.",
  "version": "0.0.0",
  "browser": "dist/main.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": ["onLanguage:sprout"],
  "languages": [
    {
      "id": "sprout",
      "extensions": [".sprout"],
      "tokenize": "src/tokenizeSprout.js"
    }
  ]
}
