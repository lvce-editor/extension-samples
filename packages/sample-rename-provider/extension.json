{
  "id": "sample.rename-provider",
  "name": "Rename Provider Sample",
  "description": "Rename every matching identifier in a document.",
  "version": "0.0.0",
  "browser": "dist/main.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": ["onLanguage:sample-rename-provider", "onRename:sample-rename-provider"],
  "languages": [
    {
      "id": "sample-rename-provider",
      "extensions": [".sample"]
    }
  ]
}
