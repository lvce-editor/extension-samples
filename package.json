{
  "name": "@lvce-editor/extension-samples-monorepo",
  "version": "0.0.0-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build.ts",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "npm run e2e --workspace=packages/e2e",
    "e2e:headless": "npm run e2e:headless --workspace=packages/e2e",
    "format": "prettier --write .",
    "knip": "knip && knip --production --exports",
    "lint": "eslint . && prettier --check .",
    "test": "node --test \"packages/**/test/**/*.test.ts\"",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.9.0",
    "@lvce-editor/server": "^0.114.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-unicorn": "71.1.0",
    "jiti": "^2.7.0",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.63.0"
  }
}
